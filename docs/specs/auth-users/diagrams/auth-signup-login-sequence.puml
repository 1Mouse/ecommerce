@startuml AuthSignupLoginSequence

title Signup And Login Sequence

skinparam linetype ortho
skinparam shadowing false
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F8FAFC
}

actor Client
participant "AuthRoutes" as Routes
participant "AuthController" as Controller
participant "AuthService" as Service
participant "UserRepository" as Users
participant "RefreshTokenRepository" as Tokens
database "MongoDB" as Mongo

== Signup ==

Client -> Routes : POST /api/v1/auth/signup\nemail, username, password
Routes -> Controller : signup(request)
Controller -> Controller : Zod strip + validate body
Controller -> Service : signup(email, username, password)
Service -> Users : findByEmail(email)
Users -> Mongo : users.findOne({ email, deletedAt: null })
Mongo --> Users : user or null
Users --> Service : user or null
alt email exists
  Service --> Controller : throw 409 EMAIL_ALREADY_EXISTS
  Controller --> Client : error envelope
else email available
  Service -> Users : findByUsername(username)
  Users -> Mongo : users.findOne({ username, deletedAt: null })
  Mongo --> Users : user or null
  alt username exists
    Service --> Controller : throw 409 USERNAME_ALREADY_EXISTS
    Controller --> Client : error envelope
  else username available
    Service -> Service : hash password
    Service -> Users : create user with passwordHash
    Users -> Mongo : users.insertOne(...)
    Mongo --> Users : created user
    Users --> Service : plain user object
    Service -> Service : create access JWT\ncreate opaque refresh token\nhash refresh token
    Service -> Tokens : create tokenHash, userId, expiresAt
    Tokens -> Mongo : refreshTokens.insertOne(...)
    Mongo --> Tokens : created refresh token row
    Tokens --> Service : refresh token record
    Service --> Controller : user + accessToken + refreshToken
    Controller --> Client : 201 { data }
  end
end

== Login ==

Client -> Routes : POST /api/v1/auth/login\nemail, password
Routes -> Controller : login(request)
Controller -> Controller : Zod strip + validate body
Controller -> Service : login(email, password)
Service -> Users : findByEmail(email)
Users -> Mongo : users.findOne({ email, deletedAt: null })
Mongo --> Users : user or null
Users --> Service : user or null
alt invalid credentials
  Service --> Controller : throw 401 INVALID_CREDENTIALS
  Controller --> Client : error envelope
else valid credentials
  Service -> Service : compare password hash
  Service -> Service : create access JWT\ncreate opaque refresh token\nhash refresh token
  Service -> Tokens : create tokenHash, userId, expiresAt
  Tokens -> Mongo : refreshTokens.insertOne(...)
  Mongo --> Tokens : created refresh token row
  Service --> Controller : user + accessToken + refreshToken
  Controller --> Client : 200 { data }
end

@enduml
