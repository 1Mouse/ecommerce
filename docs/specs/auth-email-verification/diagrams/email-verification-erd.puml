@startuml EmailVerificationERD

title Email Verification Mongo Collections

hide circle
skinparam linetype ortho
skinparam class {
  BackgroundColor #ffffff
  BorderColor #222222
  ArrowColor #222222
}

entity "users" as users {
  * _id : ObjectId
  --
  * email : string <<unique>>
  * username : string <<unique>>
  * passwordHash : string
  emailVerifiedAt : date
  imageExt : string
  phone : string
  dob : date
  * createdAt : date
  * updatedAt : date
  deletedAt : date
}

entity "emailVerificationTokens" as emailVerificationTokens {
  * _id : ObjectId
  --
  * userId : ObjectId <<index>>
  * tokenHash : string <<unique>>
  * expiresAt : date <<ttl>>
  usedAt : date
  * createdAt : date
  * updatedAt : date
  deletedAt : date
}

entity "refreshTokens" as refreshTokens {
  * _id : ObjectId
  --
  * userId : ObjectId <<index>>
  * tokenHash : string <<unique>>
  * expiresAt : date <<ttl>>
  revokedAt : date
  replacedByTokenId : ObjectId
  * createdAt : date
  * updatedAt : date
  deletedAt : date
}

users ||--o{ emailVerificationTokens : owns
users ||--o{ refreshTokens : owns_after_verification

@enduml
