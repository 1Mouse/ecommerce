@startuml VerifyEmailSequence

title Verify Email And Issue Tokens

skinparam linetype ortho
skinparam shadowing false
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F8FAFC
}

actor Client
participant "AuthController" as Controller
participant "AuthService" as AuthService
participant "EmailVerificationService" as VerificationService
participant "EmailVerificationTokenRepository" as VerificationRepo
participant "UserRepository" as Users
participant "RefreshTokenRepository" as RefreshTokens
database "MongoDB" as Mongo

Client -> Controller : POST /api/v1/auth/verify-email\ntoken
Controller -> Controller : Zod strip + validate body
Controller -> AuthService : verifyEmail(token)
AuthService -> VerificationService : verify(token)
VerificationService -> VerificationService : tokenHash = SHA-256(token)
VerificationService -> VerificationRepo : findByTokenHash(tokenHash)
VerificationRepo -> Mongo : emailVerificationTokens.findOne(...)
Mongo --> VerificationRepo : token row or null

alt token missing, expired, used, or deleted
  VerificationService --> AuthService : throw 401 INVALID_EMAIL_VERIFICATION_TOKEN
  AuthService --> Controller : error
  Controller --> Client : error envelope
else token active
  VerificationService -> Users : findById(userId)
  Users -> Mongo : users.findOne({ _id, deletedAt: null })
  Mongo --> Users : user or null
  alt user missing or deleted
    VerificationService --> AuthService : throw 401 INVALID_EMAIL_VERIFICATION_TOKEN
    AuthService --> Controller : error
    Controller --> Client : error envelope
  else user active
    VerificationService -> Users : set emailVerifiedAt = now
    Users -> Mongo : users.updateOne(...)
    VerificationService -> VerificationRepo : mark usedAt = now
    VerificationRepo -> Mongo : emailVerificationTokens.updateOne(...)
    AuthService -> AuthService : create access JWT\ncreate refresh token\nhash refresh token
    AuthService -> RefreshTokens : create refresh token row
    RefreshTokens -> Mongo : refreshTokens.insertOne(...)
    AuthService --> Controller : user + accessToken + refreshToken
    Controller --> Client : 200 { data }
  end
end

@enduml
