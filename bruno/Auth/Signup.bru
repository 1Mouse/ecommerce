meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{authSignupPath}}
  body: json
  auth: none
}

body:json {
  {
    "email": "{{authEmail}}",
    "username": "{{authUsername}}",
    "password": "{{authPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  const data = body?.data;
  
  if (data?.user?.id) {
    bru.setEnvVar("userId", data.user.id);
  }
  
  // Signup now sends a verification email. Paste the token from Mailpit into
  // verificationToken, then run Verify Email to populate auth tokens.
}
