meta {
  name: Create My Address
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{userAddressesCreateMyPath}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "countryId": "{{countryId}}",
    "label": "home",
    "city": "Cairo",
    "postalCode": "11511",
    "line1": "12 Tahrir Street",
    "line2": "Apartment 4B"
  }
}

script:post-response {
  const body = res.getBody();
  const address = body?.data;
  
  if (address?.id) {
    bru.setEnvVar("addressId", address.id);
  }
}
