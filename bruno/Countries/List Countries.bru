meta {
  name: List Countries
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{countriesListPath}}?page=1&limit=20
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  const country = body?.data?.[0];
  
  if (country?.id) {
    bru.setEnvVar("countryId", country.id);
  }
}
